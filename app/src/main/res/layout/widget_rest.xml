<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/rest_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:letterSpacing="0.1"
        android:text="REST TIMER"
        android:textColor="#F08A3C"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/rest_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="No rest running"
        android:textColor="#E6DCD2"
        android:textSize="14sp"
        android:textStyle="bold" />

    <Chronometer
        android:id="@+id/rest_clock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#E6DCD2"
        android:textSize="34sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/rest_static"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="—:——"
        android:textColor="#9A8C80"
        android:textSize="34sp"
        android:textStyle="bold" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="4dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/rest_btn_1"
            style="@style/WidgetButton"
            android:text="OPEN WORKOUT" />

        <TextView
            android:id="@+id/rest_btn_2"
            style="@style/WidgetButton"
            android:layout_marginStart="6dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/rest_btn_3"
            style="@style/WidgetButton"
            android:layout_marginStart="6dp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
